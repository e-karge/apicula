+    def get_iob_reg_attrs(self, bel: IologicBelDesc) -> list[AttrVal]:
+        """ With an input register in the same IO block, the vendor inverts
+        only the input clock for the negative edge registers. """
+        attr_vals = super().get_iob_reg_attrs(bel)
+        if 'IREG_TYPE' in bel.cell.attrs or not self.has_iob_input_reg(bel.x, bel.y, bel.idx_str):
+            return attr_vals
+        return [av for av in attr_vals if av.attr != 'CLKOMUX_CLK' and not av.attr.endswith('_OUTREGMODE')]
+
+    def has_iob_input_reg(self, x: int, y: int, idx_str: str) -> bool:
+        if not hasattr(self, 'iob_input_reg_bels'):
+            self.iob_input_reg_bels = set()
+            for cell in self.pnr.in_file['modules'][self.pnr.top_module_name]['cells'].values():
+                if cell['type'] == 'IOLOGICI_EMPTY' and int(cell['attributes'].get('HAS_REG', '0'), 2):
+                    self.iob_input_reg_bels.add(cell['attributes']['NEXTPNR_BEL'])
+        return f'X{x}Y{y}/IOLOGIC{idx_str}I' in self.iob_input_reg_bels
+
+    def get_iologic_fuse_cell(self, bel: IologicBelDesc) -> tuple[int, int]:
+        """ The IOLOGIC B fuses are in the cell with the IOB B fuses """
+        x, y = bel.x, bel.y
+        if bel.idx_str == 'B':
+            fuse_cell_offset = self.chipdb.get_iob_fuse_cell_offset(x, y, 'B')
+            if fuse_cell_offset:
+                x += fuse_cell_offset[1]
+                y += fuse_cell_offset[0]
+        return x, y
